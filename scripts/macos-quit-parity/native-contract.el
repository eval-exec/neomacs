;;; native-contract.el --- Native quit callbacks and Lisp route witness -*- lexical-binding: t -*-
(require 'json)
(defvar neomacs-quit-native-query-count 0)
(defvar neomacs-quit-native-command-count 0)
(defvar neomacs-quit-native-command-completed nil)
(defvar neomacs-quit-native-kill-count 0)
(defvar neomacs-quit-native-key nil)
(defvar neomacs-quit-native-event nil)
(defun neomacs-quit-native-state ()
  `((pid . ,(emacs-pid))
    (window-system . ,(format "%s" window-system))
    (confirm . ,(if ns-confirm-quit t :json-false))
    (query-count . ,neomacs-quit-native-query-count)
    (command-count . ,neomacs-quit-native-command-count)
    (command-completed . ,(if neomacs-quit-native-command-completed t :json-false))
    (kill-count . ,neomacs-quit-native-kill-count)
    (key . ,neomacs-quit-native-key)
    (event . ,neomacs-quit-native-event)
    (power-off-binding . ,(format "%s" (key-binding [ns-power-off])))
    (power-off-non-key . ,(if (get 'ns-power-off 'non-key-event) t :json-false))))
(defun neomacs-quit-native-write (suffix)
  (with-temp-file (concat (getenv "NEOMACS_QUIT_NATIVE_LISP") suffix)
    (insert (json-encode (neomacs-quit-native-state)))))
(setq ns-confirm-quit nil)
(pcase (getenv "NEOMACS_QUIT_NATIVE_CONFIRM")
  ("t" (setq ns-confirm-quit t))
  ("let-restored" (let ((ns-confirm-quit t)) (ignore ns-confirm-quit))))
(setq ns-command-modifier (intern (or (getenv "NEOMACS_QUIT_NATIVE_MODIFIER") "super")))
(setq confirm-kill-emacs nil
      confirm-kill-processes nil
      kill-emacs-query-functions
      (list (lambda ()
              (setq neomacs-quit-native-query-count (1+ neomacs-quit-native-query-count))
              (neomacs-quit-native-write ".state")
              nil))
      kill-emacs-hook
      (list (lambda ()
              (setq neomacs-quit-native-kill-count (1+ neomacs-quit-native-kill-count))
              (neomacs-quit-native-write ".state"))))
(advice-add 'save-buffers-kill-emacs :around
            (lambda (original &rest args)
              (setq neomacs-quit-native-command-count (1+ neomacs-quit-native-command-count)
                    neomacs-quit-native-event (format "%S" last-nonmenu-event))
              (neomacs-quit-native-write ".state")
              (prog1 (apply original args)
                (setq neomacs-quit-native-command-completed t)
                (neomacs-quit-native-write ".state"))))
(global-set-key [?\s-q]
                (lambda () (interactive)
                  (setq neomacs-quit-native-key "super-q")
                  (neomacs-quit-native-write ".state")))
(global-set-key [?\M-q]
                (lambda () (interactive)
                  (setq neomacs-quit-native-key "meta-q")
                  (neomacs-quit-native-write ".state")))
;; Normal timer wakeups let GNU drain terminate:'s queued NS event. They do
;; not create the event, call the command, or alter its non-key provenance.
(run-at-time 0.1 0.1 #'ignore)
(run-at-time 0.5 nil (lambda () (neomacs-quit-native-write ".ready")))
(when (equal (getenv "NEOMACS_QUIT_NATIVE_LISP_KEY") "t")
  (run-at-time 0.75 nil (lambda () (execute-kbd-macro [?\s-q]))))
(run-at-time 50 nil (lambda () (kill-emacs 0)))
