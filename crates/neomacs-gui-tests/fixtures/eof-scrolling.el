;;; eof-scrolling.el --- Final-row scrolling through real GUI frames -*- lexical-binding: t; -*-

(require 'json)
(setq inhibit-startup-screen t)
(menu-bar-mode -1)
(tool-bar-mode -1)
(set-frame-size nil 400 180 t)

(defun eof-scrolling-setup (tall offset)
  (switch-to-buffer (get-buffer-create "*eof-scrolling*"))
  (erase-buffer)
  (insert "a\nb\nX")
  (setq-local mode-line-format nil)
  (setq-local header-line-format nil)
  (setq-local tab-line-format nil)
  (when tall (put-text-property 5 6 'display '(space :height (400))))
  (goto-char 5)
  (set-window-start nil 5 t)
  (set-window-vscroll nil offset t)
  (redisplay t))

(defun eof-scrolling-try (amount)
  (condition-case nil (progn (scroll-up amount) 'moved)
    (end-of-buffer 'end-of-buffer)))

(defun eof-scrolling-probe ()
  (let ((auto-window-vscroll nil)
        (scroll-preserve-screen-position nil)
        (next-screen-context-lines 2)
        out)
    (eof-scrolling-setup nil 0)
    (push (list (eof-scrolling-try nil) (window-start) (point)
                (window-vscroll nil t)) out)
    (dolist (amount '(nil 1))
      (eof-scrolling-setup t 0)
      (let ((first (eof-scrolling-try amount)))
        (push (list first (window-start) (point)
                    (= (window-vscroll nil t)
                       (- 400 (window-body-height nil t)))
                    (eof-scrolling-try amount)) out)))
    (eof-scrolling-setup t 32)
    (scroll-up)
    (let ((first (list (window-start) (point)
                       (= (window-vscroll nil t)
                          (- 400 (window-body-height nil t) 32)))))
      (scroll-up)
      (push (list first (window-start) (point) (window-vscroll nil t)) out))
    (with-temp-file (getenv "NEOMACS_GUI_STATE_JSON")
      (insert (json-encode (vconcat (nreverse out))))))
  (when (fboundp 'neomacs--write-frame-snapshot)
    (neomacs--write-frame-snapshot
     (concat (getenv "NEOMACS_GUI_STATE_JSON") ".frame.json") nil 'json))
  (kill-emacs 0))

(run-at-time
 1 nil
 (lambda ()
   (condition-case err (eof-scrolling-probe)
     (error
      (with-temp-file (getenv "NEOMACS_GUI_STATE_JSON")
        (prin1 err (current-buffer)))
      (kill-emacs 1)))))
