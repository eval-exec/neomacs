;;; line-number-scaled-cursor.el --- #265 geometry oracle -*- lexical-binding: t; -*-
(require 'json)
(require 'hl-line)
(require 'face-remap)
(setq inhibit-startup-screen t initial-scratch-message nil)
(menu-bar-mode -1)
(tool-bar-mode -1)
(scroll-bar-mode -1)
(blink-cursor-mode -1)
(defun cursor265-start ()
  (set-frame-font "DejaVu Sans Mono-14" nil t)
  (set-window-fringes nil 0 0)
  (set-face-attribute 'default nil :foreground "#ffffff" :background "#000000")
  (set-face-attribute 'hl-line nil :background "#202020" :extend t)
  (set-cursor-color "#00ffff")
  (modify-frame-parameters nil '((cursor-type . box)))
  (switch-to-buffer (get-buffer-create "*scaled-cursor-265*"))
  (setq-local mode-line-format nil header-line-format nil)
  (insert "mmmmmmmm\n")
  ;; The magenta reference spans exactly the same eight character cells as
  ;; the first line. Its left/right edges independently locate BOL/EOL.
  (insert (propertize "        " 'face '(:background "#ff00ff")) "\n")
  (display-line-numbers-mode 1)
  (if (equal (getenv "CURSOR265_HIGHLIGHT") "global")
      (global-hl-line-mode 1)
    (hl-line-mode 1))
  (text-scale-set (string-to-number (getenv "CURSOR265_SCALE")))
  (goto-char (point-min))
  ;; Start at the opposite edge; the driver sends real C-a/C-e.
  (unless (equal (getenv "CURSOR265_EDGE") "end") (end-of-line))
  (if global-hl-line-mode (global-hl-line-highlight) (hl-line-highlight))
  (select-frame-set-input-focus (selected-frame))
  (redisplay t)
  (add-hook 'post-command-hook #'cursor265-after-command)
  (with-temp-file (concat (getenv "CURSOR265_RESULT") ".ready")
    (insert (number-to-string (emacs-pid)))))
(defun cursor265-after-command ()
  (when (memq this-command '(move-beginning-of-line move-end-of-line))
    (remove-hook 'post-command-hook #'cursor265-after-command)
    (run-at-time 0.3 nil #'cursor265-observe)))
(defun cursor265-observe ()
  ;; Observe normal command redisplay before any forced redraw can repair it.
  (with-current-buffer "*scaled-cursor-265*"
   (let ((state `((point . ,(point)) (scale . ,text-scale-mode-amount)
                 (family . ,(font-get (font-at (point-min)) :family))
                 (cursor . ,(window-cursor-info))
                 (bol . ,(car (posn-x-y (posn-at-point (point-min)))))
                 (eol . ,(car (posn-x-y (posn-at-point (+ (point-min) 8)))))
                 (line_numbers . ,(if display-line-numbers t :json-false))
                 (highlight . ,(if (or hl-line-mode global-hl-line-mode) t :json-false)))))
    (with-temp-file (getenv "CURSOR265_RESULT") (insert (json-encode state)))))
  (run-at-time 1 nil (lambda () (kill-emacs 0))))
(run-at-time 0.5 nil #'cursor265-start)
