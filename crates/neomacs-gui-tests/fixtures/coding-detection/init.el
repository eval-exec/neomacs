;;; Coding preferences govern interactive file reads and saves. -*- lexical-binding: t -*-
(require 'json)
(defun coding-detection-case (directory name bytes expected-coding expected-text)
  (let* ((file (expand-file-name name directory))
         (coding-system-for-read nil)
         (coding-system-for-write nil)
         (make-backup-files nil)
         read-coding saved-coding read-text saved-bytes)
    (let ((coding-system-for-write 'no-conversion)) (write-region bytes nil file))
    (find-file file)
    (setq read-coding buffer-file-coding-system read-text (buffer-string))
    (unless (and (eq read-coding expected-coding) (equal read-text expected-text))
      (error "%s read as %S with characters %S" name read-coding (string-to-list read-text)))
    (goto-char (point-max)) (insert "abc\n") (redisplay t)
    (execute-kbd-macro (kbd "C-x C-s"))
    (setq saved-coding buffer-file-coding-system)
    (with-temp-buffer
      (set-buffer-multibyte nil) (insert-file-contents-literally file)
      (setq saved-bytes (vconcat (string-to-list (buffer-string)))))
    `((file . ,name) (read-coding . ,(symbol-name read-coding))
      (saved-coding . ,(symbol-name saved-coding))
      (characters . ,(vconcat (string-to-list read-text))) (bytes . ,saved-bytes))))
(defun coding-detection-probe ()
  (let* ((state-file (getenv "NEOMACS_GUI_STATE_JSON"))
         (directory (file-name-directory state-file)) cases)
    (set-language-environment 'Chinese-GB)
    (push (coding-detection-case directory "gbk.txt" (unibyte-string #x86 #xaa #xe0 #xc2 #x0a)
                                 'chinese-gbk-unix "啰嗦\n") cases)
    (push (coding-detection-case directory "gbk-control.txt" (unibyte-string #xd6 #xd0 #xce #xc4 #xe9 #x46 #x0a)
                                 'chinese-gbk-unix "中文镕\n") cases)
    (prefer-coding-system 'windows-1252)
    (push (coding-detection-case directory "windows-1252.txt" (unibyte-string #x80 #x20 #x31 #x30 #x0a)
                                 'windows-1252-unix "€ 10\n") cases)
    (switch-to-buffer (get-buffer-create "*coding-detection*"))
    (insert "GBK and Windows-1252 files opened and saved correctly\n") (redisplay t)
    (let ((coding-system-for-write 'utf-8-unix))
      (with-temp-file state-file
        (insert (json-encode `((cases . ,(vconcat (nreverse cases)))
                              (native-engine . ,(if (fboundp 'neomacs--write-frame-snapshot) t :json-false))))))))
  (kill-emacs 0))
(run-with-timer 1 nil
                (lambda ()
                  (condition-case err (coding-detection-probe)
                    (error (let ((coding-system-for-write 'utf-8-unix))
                             (with-temp-file (getenv "NEOMACS_GUI_STATE_JSON")
                               (insert (json-encode `((error . ,(format "%S" err)))))))
                           (kill-emacs 1)))))
