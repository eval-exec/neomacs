;;; Category wrapping through real redisplay. -*- lexical-binding: t; -*-
(require 'json)
(defvar wrap623-counter 0)
(defun wrap623-row (text enabled &optional setup character-wrap)
  (switch-to-buffer (get-buffer-create (format "*wrap623-%d*" (setq wrap623-counter (1+ wrap623-counter)))))
  (insert text)
  (set-category-table (copy-category-table))
  (setq-local word-wrap (not character-wrap) truncate-lines nil
              truncate-partial-width-windows nil word-wrap-by-category enabled)
  (when setup (funcall setup))
  (goto-char 1)
  (set-window-start (selected-window) 1 t)
  (redisplay t)
  (vertical-motion 1)
  (point))
(defun wrap623-probe ()
  (delete-other-windows)
  (select-window (split-window nil -24 'right))
  (let* ((cjk (concat "supertag v0.4 " (make-string 60 ?提)))
         (ascii (concat "supertag v0.4 " (make-string 60 ?x)))
         (edge (wrap623-row (make-string 80 ?x) nil nil t))
         (closing (concat (make-string (1- edge) ?x) "!" (make-string 20 ?x)))
         (opening (concat (make-string (- edge 2) ?x) "?" (make-string 20 ?x)))
         (letters (lambda () (modify-category-entry ?x ?|)))
         (out
          (list
           (cons "native-engine" (if (fboundp 'neomacs--write-frame-snapshot) t :json-false))
           (cons "width" (window-body-width))
           (cons "cjk" (vector (wrap623-row cjk nil) (wrap623-row cjk t)
                               (wrap623-row cjk t (lambda () (modify-category-entry ?提 ?| nil t)))))
           (cons "ascii" (vector (wrap623-row ascii t) (wrap623-row ascii t letters)))
           (cons "not-at-bol"
                 (vector (wrap623-row closing t (lambda () (funcall letters) (modify-category-entry ?! ?|)))
                         (wrap623-row closing t (lambda () (funcall letters) (modify-category-entry ?! ?|) (modify-category-entry ?! ?>)))))
           (cons "not-at-eol"
                 (vector (wrap623-row opening t (lambda () (funcall letters) (modify-category-entry ?? ?|)))
                         (wrap623-row opening t (lambda () (funcall letters) (modify-category-entry ?? ?|) (modify-category-entry ?? ?<))))))))
    (with-temp-file (getenv "NEOMACS_GUI_STATE_JSON")
      (insert (json-encode out))))
  (when (fboundp 'neomacs--write-frame-snapshot)
    (neomacs--write-frame-snapshot (concat (getenv "NEOMACS_GUI_STATE_JSON") ".frame.json") nil 'json))
  (kill-emacs 0))
(run-with-timer 1 nil
 (lambda ()
  (condition-case err (wrap623-probe)
   (error (with-temp-file (getenv "NEOMACS_GUI_STATE_JSON")
            (insert (json-encode (list (cons "error" (format "%S" err))))))
          (kill-emacs 1)))))
