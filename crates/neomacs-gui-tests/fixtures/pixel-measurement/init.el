;;; Pixel measurements compared with actual redisplay. -*- lexical-binding: t; -*-
(require 'subr-x)
(require 'json)
(defun pixel-width-probe ()
  (let ((cases (list (cons "variable-pitch" (propertize "WWWWWWWWWW" 'face 'variable-pitch))
                     (cons "height" (propertize "abc" 'face '(:height 2.0)))
                     (cons "pixel-space" (propertize " " 'display '(space :width (50))))
                     (cons "emoji" "😀😀😀")))
        (out nil))
    (switch-to-buffer (get-buffer-create "*pixel-probe*"))
    (erase-buffer)
    (setq-local mode-line-format nil)
    (dolist (c cases) (insert (cdr c) "x\n"))
    (push (list "native-engine" (if (fboundp 'neomacs--write-frame-snapshot) t :json-false)) out)
    (goto-char (point-min))
    (redisplay t)
    (dolist (c cases)
      (search-forward "x")
      (let ((end (1- (point))))
        (push (list (car c)
                    (car (posn-x-y (posn-at-point end)))
                    (car (window-text-pixel-size nil (line-beginning-position) end))
                    (string-pixel-width (cdr c))) out)))
    (when (display-graphic-p)
      (push (list "partial-row" (car (window-text-pixel-size nil 3 7 t))) out)
      (push (list "height-pixels" (cdr (window-text-pixel-size nil 13 16 t))
                  (- (cdr (posn-x-y (posn-at-point 18))) (cdr (posn-x-y (posn-at-point 13))))) out)
      (let ((size (window-text-pixel-size nil 1 11 t 1)))
        (push (list "y-limit" (vector (car size) (cdr size))) out)))
    (when (display-graphic-p)
      (with-temp-buffer
        (insert "a")
        (let ((overlay (make-overlay (point-max) (point-max))))
          (overlay-put overlay 'before-string (propertize "WW" 'face 'variable-pitch))
          (push (list "end-overlay" (car (buffer-text-pixel-size nil nil t))
                      (string-pixel-width (concat "a" (propertize "WW" 'face 'variable-pitch)))) out)))
      (with-temp-buffer
        (insert "WWWWWWWWWW")
        (setq-local face-remapping-alist '((default variable-pitch default)))
        (push (list "source-remapping" (car (buffer-text-pixel-size nil nil t))) out))
      (save-window-excursion
        (switch-to-buffer (get-buffer-create "*pixel-wrapped-probe*"))
        (erase-buffer) (insert (make-string 120 ?a))
        (setq-local truncate-lines nil word-wrap nil)
        (let ((bounded (window-text-pixel-size nil 82 84 32 1))
              (unbounded (window-text-pixel-size nil 82 84 32)))
          (push (list "wrapped-origin" (car bounded) (car unbounded) (cdr bounded)) out))
        (let ((bounded (window-text-pixel-size nil 81 83 32 1))
              (unbounded (window-text-pixel-size nil 81 83 32)))
          (push (list "wrapped-boundary" (car bounded) (car unbounded) (cdr bounded)) out))
        (erase-buffer) (insert "fi")
        (compose-region 1 3 "界")
        (push (list "partial-composition"
                    (car (window-text-pixel-size nil 1 2 t))
                    (car (window-text-pixel-size nil 1 3 t))) out)
        (insert "X")
        (push (list "composition-origin"
                    (car (window-text-pixel-size nil 2 3 t))
                    (car (window-text-pixel-size nil 2 4 t))
                    (string-pixel-width "X")) out)
        (erase-buffer) (insert "abcdefghij\nx")
        (let ((size (window-text-pixel-size nil 11 12 t)))
          (push (list "newline-only" (car size) (cdr size) (frame-char-height)) out))
        (let ((size (window-text-pixel-size nil 11 13 t)))
          (push (list "newline-origin" (car size) (string-pixel-width "x")
                      (cdr size) (* 2 (frame-char-height))) out)))
      (redisplay t))
    (let ((before (list (window-buffer) (window-start) (window-point) (window-hscroll) (window-vscroll nil t))))
      (push (list "long-string"
                  (string-pixel-width (propertize (make-string 100 ?W) 'face 'variable-pitch))) out)
      (push (list "window-preserved"
                  (equal before (list (window-buffer) (window-start) (window-point) (window-hscroll) (window-vscroll nil t)))) out))
    (with-temp-file (getenv "NEOMACS_GUI_STATE_JSON") (insert (json-encode (nreverse out)))))
  (when (fboundp 'neomacs--write-frame-snapshot)
    (neomacs--write-frame-snapshot (concat (getenv "NEOMACS_GUI_STATE_JSON") ".frame.json") nil 'json))
  (kill-emacs 0))
(run-with-timer 1 nil (lambda ()
  (condition-case err (pixel-width-probe)
    (error (with-temp-file (getenv "NEOMACS_GUI_STATE_JSON") (prin1 err (current-buffer))) (kill-emacs 1)))))
