;;; issue-381-menu-bar.el --- Wide heading hit rectangle -*- lexical-binding: t -*-
(load (expand-file-name "native-menus.el" (file-name-directory load-file-name)))
(defun neomacs-heading-first ()
  (interactive)
  (with-temp-file (expand-file-name "selected-heading" neomacs-menu-directory)
    (insert "first")))
(defun neomacs-heading-second ()
  (interactive)
  (with-temp-file (expand-file-name "selected-heading" neomacs-menu-directory)
    (insert "second")))
(let ((first (make-sparse-keymap)) (second (make-sparse-keymap)))
  (define-key first [choose] '(menu-item "Choose first" neomacs-heading-first))
  (define-key second [choose] '(menu-item "Choose second" neomacs-heading-second))
  (define-key global-map [menu-bar file] (list 'menu-item "中中中中" first))
  (define-key global-map [menu-bar edit] (list 'menu-item "Edit" second)))
(blink-cursor-mode -1)
(setq-default cursor-type nil)
