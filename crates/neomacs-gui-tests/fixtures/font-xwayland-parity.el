;;; font-xwayland-parity.el --- Native desktop font witness -*- lexical-binding: t; -*-
(require 'json)
(require 'subr-x)
(require 'dynamic-setting)
(setq inhibit-startup-screen t native-comp-jit-compilation nil
      native-comp-enable-subr-trampolines nil)

(defvar font-xwayland-directory (getenv "NEOMACS_FONT_XWAYLAND_CONTROL"))
(defvar font-xwayland-text "Hamburgefontsiv 0123456789")
(defvar font-xwayland-rows nil)
(defvar font-xwayland-events nil)
(defvar font-xwayland-pending nil)
(defvar font-xwayland-received 0)
(defvar font-xwayland-completed 0)
(defvar font-xwayland-sample 0)
(defvar font-xwayland-phase nil)
(defvar font-xwayland-phase-samples 0)
(defvar font-xwayland-stable 0)
(defvar font-xwayland-previous nil)

(defun font-xwayland-before (event)
  (when (eq (nth 1 event) 'font-render)
    (setq font-xwayland-received (1+ font-xwayland-received))
    (let ((entry `((sequence . ,font-xwayland-received)
                   (event . ,(prin1-to-string event)) (completed . :false))))
      (push entry font-xwayland-events)
      (push entry font-xwayland-pending))))

(defun font-xwayland-after (event)
  (when (eq (nth 1 event) 'font-render)
    (let ((entry (pop font-xwayland-pending)))
      (when entry
        (setcdr (assq 'completed entry) t)
        (setq font-xwayland-completed (1+ font-xwayland-completed))))))

;; Observe real notifications, keeping the installed normal handler intact.
;; Its ordinary cache reconsideration is part of the behavior being tested.
(advice-add 'dynamic-setting-handle-config-changed-event :before #'font-xwayland-before)
(advice-add 'dynamic-setting-handle-config-changed-event :after #'font-xwayland-after)

(defun font-xwayland-data (value)
  "Preserve positional font/glyph data as JSON arrays, including nested lists."
  (cond ((null value) :null) ((eq value t) t)
        ((or (numberp value) (stringp value)) value)
        ((symbolp value) (symbol-name value))
        ((or (vectorp value) (listp value))
         (vconcat (mapcar #'font-xwayland-data value)))
        (t (prin1-to-string value))))

(defun font-xwayland-write (path state)
  (let ((temporary (concat path ".tmp")) (json-null :null) (json-false :false))
    (with-temp-file temporary (insert (json-encode state)))
    (rename-file temporary path t)))

(defun font-xwayland-control-phase ()
  (let* ((path (expand-file-name "phase" font-xwayland-directory))
         (phase (if (file-exists-p path)
                    (with-temp-buffer
                      (insert-file-contents path)
                      (string-trim (buffer-string)))
                  "startup")))
    (unless (string-match-p "\\`[A-Za-z0-9_-]+\\'" phase)
      (error "Invalid font observation phase: %S" phase))
    phase))

(defun font-xwayland-probe (position window)
  (let* ((posn (posn-at-point position window))
         (xy (and posn (posn-x-y posn)))
         (size (and posn (posn-object-width-height posn)))
         (absolute (window-absolute-pixel-position position window)))
    (unless (and (numberp (car xy)) (numberp (cdr xy)))
      (error "Position %s is not displayed" position))
    `((position . ,position) (xy . ,(vector (car xy) (cdr xy)))
      (absolute . ,(if absolute (vector (car absolute) (cdr absolute)) :null))
      (object_size . ,(if size (vector (car size) (cdr size)) :null)))))

(defun font-xwayland-row (entry window edges)
  (let* ((start (cdr entry)) (length (length font-xwayland-text))
         (font (font-at start window)) (info (font-info font))
         (probes (vconcat (mapcar (lambda (offset)
                                   (font-xwayland-probe (+ start offset) window))
                                 (number-sequence 0 length))))
         (first (alist-get 'xy (aref probes 0)))
         (last (alist-get 'xy (aref probes length)))
         (next (save-excursion
                 (goto-char start) (forward-line 1)
                 (posn-x-y (posn-at-point (point) window))))
         (top (+ (nth 1 edges) (aref first 1)))
         (bottom (+ (nth 1 edges) (cdr next)))
         glyphs glyph-error fields regions)
    (unless (vectorp info) (error "No font-info vector for %S" font))
    (condition-case failure
        (setq glyphs (font-get-glyphs font 0 length font-xwayland-text))
      (error (setq glyph-error (prin1-to-string failure))))
    ;; font.c:5594 documents every field; no platform metric literals here.
    (let ((index 0))
      (dolist (name '(opened_name full_name size height baseline_offset
                     relative_compose default_ascent max_width ascent descent
                     space_width average_width file capability))
        (push (cons name (if (< index (length info))
                             (font-xwayland-data (aref info index)) :null)) fields)
        (setq index (1+ index))))
    (dotimes (index length)
      (let* ((probe (aref probes index))
             (xy (alist-get 'xy probe))
             (end (alist-get 'xy (aref probes (1+ index)))))
        (push `((offset . ,index) (character . ,(substring font-xwayland-text index (1+ index)))
                (probe . ,probe)
                (bounds . ,(vector (+ (nth 0 edges) (aref xy 0)) top
                                   (+ (nth 0 edges) (aref end 0)) bottom))
                (advance . ,(- (aref end 0) (aref xy 0)))) regions)))
    `((name . ,(symbol-name (car entry))) (text . ,font-xwayland-text)
      (family . ,(format "%s" (font-get font :family)))
      (weight . ,(format "%s" (font-get font :weight)))
      (slant . ,(format "%s" (font-get font :slant)))
      (size . ,(font-get font :size))
      (file . ,(font-xwayland-data (aref info 12)))
      (font . ,(prin1-to-string font))
      (font_info . ,(font-xwayland-data info))
      (font_info_fields . ,(nreverse fields))
      (glyphs . ,(font-xwayland-data glyphs))
      (glyph_error . ,(or glyph-error :null))
      (probes . ,probes) (glyph_regions . ,(vconcat (nreverse regions)))
      (bounds . ,(vector (nth 0 edges) top (nth 2 edges) bottom))
      (advance . ,(- (aref last 0) (aref first 0))))))

(defun font-xwayland-observe ()
  (let ((phase (font-xwayland-control-phase)))
    (if (equal phase "stop") (kill-emacs 0)
      (unless (equal phase font-xwayland-phase)
        (setq font-xwayland-phase phase font-xwayland-phase-samples 0
              font-xwayland-previous nil font-xwayland-stable 0))
      (with-selected-window (get-buffer-window "*font-xwayland-parity*")
        ;; Ordinary redisplay only. Do not force cache flushes or reopen fonts.
        (redisplay t)
        (let* ((window (selected-window)) (edges (window-inside-pixel-edges window))
               (observation
                `((font_render_setting_feature . ,(if (featurep 'font-render-setting) t :false))
                  (xft_settings_bound . ,(if (boundp 'xft-settings) t :false))
                  (xft_settings . ,(if (boundp 'xft-settings)
                                       (font-xwayland-data xft-settings) :null))
                  (frame_char_width . ,(frame-char-width))
                  (frame_char_height . ,(frame-char-height))
                  (frame_pixel_size . ,(vector (frame-pixel-width) (frame-pixel-height)))
                  (frame_columns . ,(frame-width)) (frame_lines . ,(frame-height))
                  (window_edges . ,(vconcat edges))
                  (window_pixel_edges . ,(vconcat (window-pixel-edges window)))
                  (rows . ,(vconcat (mapcar (lambda (entry)
                                            (font-xwayland-row entry window edges))
                                          font-xwayland-rows)))))
               (identity (list font-xwayland-completed font-xwayland-received observation)))
          (setq font-xwayland-sample (1+ font-xwayland-sample)
                font-xwayland-phase-samples (1+ font-xwayland-phase-samples)
                font-xwayland-stable (if (equal identity font-xwayland-previous)
                                         (1+ font-xwayland-stable) 1)
                font-xwayland-previous identity)
          (let ((state (append
                        `((complete . t) (phase . ,phase) (pid . ,(emacs-pid))
                          (sample . ,font-xwayland-sample)
                          (phase_samples . ,font-xwayland-phase-samples)
                          (stable_samples . ,font-xwayland-stable)
                          (received_event_count . ,font-xwayland-received)
                          (event_count . ,font-xwayland-completed)
                          (events . ,(vconcat (reverse font-xwayland-events)))) observation)))
            (font-xwayland-write (expand-file-name (concat phase ".json") font-xwayland-directory) state)
            (when (getenv "NEOMACS_GUI_STATE_JSON")
              (font-xwayland-write (getenv "NEOMACS_GUI_STATE_JSON") state))))))))

(defun font-xwayland-tick ()
  (condition-case failure (font-xwayland-observe)
    (error
     (font-xwayland-write (expand-file-name "error.json" font-xwayland-directory)
                         `((complete . :false) (phase . ,(or font-xwayland-phase :null))
                           (received_event_count . ,font-xwayland-received)
                           (event_count . ,font-xwayland-completed)
                           (error . ,(prin1-to-string failure)))))))

(unless (and font-xwayland-directory (file-directory-p font-xwayland-directory))
  (error "NEOMACS_FONT_XWAYLAND_CONTROL must name the owned control directory"))
(menu-bar-mode -1)
(tool-bar-mode -1)
(scroll-bar-mode -1)
(when (fboundp 'tab-bar-mode) (tab-bar-mode -1))
(blink-cursor-mode -1)
(set-fringe-mode 0)
(set-frame-parameter nil 'internal-border-width 0)
(set-frame-parameter nil 'cursor-type nil)
(switch-to-buffer (get-buffer-create "*font-xwayland-parity*"))
(setq-local mode-line-format nil header-line-format nil cursor-type nil
            line-spacing nil truncate-lines t display-line-numbers nil)
(set-face-attribute 'default nil :family "IBM Plex Sans" :height 120
                    :weight 'normal :slant 'normal :foreground "black" :background "white")
;; Fix physical pixels once at startup; desktop setting changes use only the
;; ordinary event handler. At the harness's 96 DPI this is the reporter's 120 height.
(set-face-attribute 'default nil :font (font-spec :family "IBM Plex Sans" :size 16
                                                 :weight 'normal :slant 'normal))
(erase-buffer)
(dolist (weight '(normal bold))
  (push (cons weight (point)) font-xwayland-rows)
  (insert (propertize font-xwayland-text 'face `(:weight ,weight)) "\n\n"))
(setq font-xwayland-rows (nreverse font-xwayland-rows))
(goto-char (point-min))
(run-at-time 0.3 0.15 #'font-xwayland-tick)
(run-at-time 120 nil (lambda () (kill-emacs 2)))
