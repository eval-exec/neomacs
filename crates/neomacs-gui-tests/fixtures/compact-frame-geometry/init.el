;;; Public multi-frame compact geometry regression. -*- lexical-binding: t; -*-
(defvar compact-bar-mode nil)
(defvar compact-test-frame nil)
(defun compact-test-snapshot (tag)
  (neomacs--write-frame-snapshot
   (concat (getenv "NEOMACS_GUI_FRAME_SNAPSHOT_JSON") "." tag)
   compact-test-frame 'json))
(defun compact-test-finish ()
  (compact-test-snapshot "font")
  (with-temp-file (getenv "NEOMACS_GUI_STATE_JSON") (insert "{}"))
  (kill-emacs 0))
(defun compact-test-font ()
  (compact-test-snapshot "renamed")
  (set-frame-font (font-spec :family "DejaVu Sans Mono" :size 28)
                  t (list compact-test-frame) t)
  (run-with-timer 1 nil #'compact-test-finish))
(defun compact-test-rename ()
  (set-frame-parameter compact-test-frame 'name "renamed-unselected")
  (run-with-timer 1 nil #'compact-test-font))
(defun compact-test-select-other ()
  (compact-test-snapshot "before")
  (select-frame (make-frame '((name . "other-frame"))))
  (run-with-timer 1 nil #'compact-test-rename))
(run-with-timer
 2 nil
 (lambda ()
   (setq compact-test-frame (selected-frame))
   (set-default 'compact-bar-mode t)
   (force-mode-line-update t)
   (run-with-timer 1 nil #'compact-test-select-other)))
