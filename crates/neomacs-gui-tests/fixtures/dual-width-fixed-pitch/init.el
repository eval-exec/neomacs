;;; Fixed-pitch does not imply that CJK glyphs occupy one cell. -*- lexical-binding: t; -*-
(require 'json)
(when (display-graphic-p)
  (set-frame-font (font-spec :family "PlemolJP Console NF" :size 13) nil t))
(switch-to-buffer (get-buffer-create "cjk"))
(erase-buffer)
(insert "ab漢字かなcd")
(goto-char (point-min))
(defun cjk-probe-finish ()
  (redisplay t)
  (let ((state (list
                (cons 'positions (mapcar (lambda (pos) (car (posn-x-y (posn-at-point pos)))) (number-sequence 1 9)))
                (cons 'width (string-pixel-width "漢字"))
                (cons 'ascii (string-pixel-width "a"))
                (cons 'columns (string-width "ab漢字かなcd")))))
    (with-temp-file (getenv "NEOMACS_GUI_STATE_JSON") (insert (json-encode state))))
  (when (fboundp 'neomacs--write-frame-snapshot)
    (neomacs--write-frame-snapshot (concat (getenv "NEOMACS_GUI_STATE_JSON") ".frame.json") nil 'json))
  (kill-emacs 0))
(run-with-timer 2 nil #'cjk-probe-finish)
