;;; Save a charset-only character through the interactive command. -*- lexical-binding: t -*-
(require 'json)
(defun coding-save-probe ()
  (let* ((make-backup-files nil)
         (state-file (getenv "NEOMACS_GUI_STATE_JSON"))
         (file (expand-file-name "cp932.txt" (file-name-directory state-file)))
         read-coding saved-coding bytes)
    (let ((coding-system-for-write 'no-conversion))
      (write-region (unibyte-string #x8a #xbf #x8e #x9a #x87 #x40 #x0a) nil file))
    (find-file file)
    (setq read-coding buffer-file-coding-system)
    (goto-char (point-max))
    (insert "abc\n")
    (redisplay t)
    (execute-kbd-macro (kbd "C-x C-s"))
    (setq saved-coding buffer-file-coding-system)
    (with-temp-buffer
      (set-buffer-multibyte nil)
      (insert-file-contents-literally file)
      (setq bytes (vconcat (string-to-list (buffer-string)))))
    (with-temp-file state-file
      (insert (json-encode `((read-coding . ,(symbol-name read-coding))
                            (saved-coding . ,(symbol-name saved-coding))
                            (bytes . ,bytes)
                            (native-engine . ,(if (fboundp 'neomacs--write-frame-snapshot) t :json-false)))))))
  (kill-emacs 0))
(run-with-timer 1 nil
                (lambda ()
                  (condition-case err (coding-save-probe)
                    (error (with-temp-file (getenv "NEOMACS_GUI_STATE_JSON")
                             (insert (json-encode `((error . ,(format "%S" err))))))
                           (kill-emacs 1)))))
