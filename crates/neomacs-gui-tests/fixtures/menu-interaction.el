;;; menu-interaction.el --- Native menu behavior -*- lexical-binding: t -*-
(load (expand-file-name "native-menus.el" (file-name-directory load-file-name)))
(switch-to-buffer (get-buffer-create "*Menu interaction*"))
(erase-buffer)
(blink-cursor-mode -1)
(setq-local cursor-type nil)
(setq inhibit-startup-screen t)
(defvar neomacs-menu-events nil)
(defvar neomacs-menu-checked nil)
(defvar neomacs-menu-test-map nil)
(defun neomacs-menu-record (event)
  (push event neomacs-menu-events)
  (with-temp-file (expand-file-name "events.json" neomacs-menu-directory)
    (insert (json-encode (vconcat (reverse neomacs-menu-events))))))
(defun neomacs-menu-choose () (interactive) (neomacs-menu-record "choose"))
(defun neomacs-menu-nested () (interactive) (neomacs-menu-record "nested"))
(defun neomacs-menu-other () (interactive) (neomacs-menu-record "other"))
(defun neomacs-menu-toggle ()
  (interactive)
  (setq neomacs-menu-checked (not neomacs-menu-checked))
  (neomacs-menu-record (if neomacs-menu-checked "checked" "unchecked")))
(defun neomacs-menu-save-text ()
  (with-temp-file (expand-file-name "text" neomacs-menu-directory)
    (insert (with-current-buffer "*Menu interaction*" (buffer-string)))))
(add-hook 'post-command-hook #'neomacs-menu-save-text)
(neomacs-menu-record "ready")
(let ((root (make-sparse-keymap))
      (child (make-sparse-keymap))
      (other (make-sparse-keymap)))
  (define-key child [choose] '(menu-item "Nested action" neomacs-menu-nested))
  ;; Define in reverse display order.
  (define-key root [toggle] '(menu-item "Toggle" neomacs-menu-toggle
                                      :button (:toggle . neomacs-menu-checked)))
  (define-key root [disabled] '(menu-item "Disabled" neomacs-menu-other :enable nil))
  (define-key root [child] (list 'menu-item "Submenu" child))
  (define-key root [choose] '(menu-item "Choose" neomacs-menu-choose))
  (define-key other [choose] '(menu-item "Other action" neomacs-menu-other))
  (setq neomacs-menu-test-map root)
  (define-key global-map [menu-bar file] (list 'menu-item "中中中中" root))
  (define-key global-map [menu-bar edit] (list 'menu-item "Other" other)))

(defun neomacs-menu-context (event)
  (interactive "e")
  (popup-menu neomacs-menu-test-map event))
(local-set-key [down-mouse-3] #'neomacs-menu-context)
