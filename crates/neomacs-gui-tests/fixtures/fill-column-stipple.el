;;; fill-column-stipple.el --- Issue #600 background bitmap -*- lexical-binding: t -*-
(require 'json)
(setq inhibit-startup-screen t initial-scratch-message nil)
(menu-bar-mode -1)
(tool-bar-mode -1)
(blink-cursor-mode -1)
(set-frame-size nil 640 360 t)
(set-face-attribute 'default nil :foreground "#101010" :background "#ffffff")
(set-face-attribute 'fill-column-indicator nil :foreground "#ed1731")
(setq-default display-fill-column-indicator-character ?\s)
(defun adjust-fill-column-indicator-stipple ()
  "The issue author's original bitmap setup."
  (let* ((w (window-font-width))
         (stipple `(,w 1 ,(apply #'unibyte-string
                                 (append (make-list (1- (/ (+ w 7) 8)) ?\0)
                                         '(1))))))
    (set-face-attribute 'fill-column-indicator nil :stipple stipple)))
(defun neomacs-fill-column-stipple-start ()
  (condition-case err
      (progn
        (switch-to-buffer (get-buffer-create "*fill-column-stipple*"))
        (erase-buffer)
        (setq-local mode-line-format nil cursor-type nil fill-column 16)
        (adjust-fill-column-indicator-stipple)
        (display-fill-column-indicator-mode 1)
        (dotimes (_ 6) (insert "x\n"))
        (goto-char (point-min))
        (redisplay t)
        (run-at-time 0.4 nil #'neomacs-fill-column-stipple-finish))
    (error (princ (format "stipple fixture: %S\n" err) 'external-debugging-output)
           (kill-emacs 1))))
(defun neomacs-fill-column-stipple-finish ()
  (with-temp-file (getenv "NEOMACS_GUI_STATE_JSON")
    (insert (json-encode `((graphic . ,(if (display-graphic-p) t :json-false))
                          (font_width . ,(window-font-width))
                          (text_left . ,(car (window-inside-pixel-edges)))
                          (fill_column . ,(buffer-local-value 'fill-column (window-buffer)))
                          (frame_width . ,(frame-pixel-width))))))
  (when (fboundp 'neomacs--write-frame-snapshot)
    (neomacs--write-frame-snapshot (getenv "NEOMACS_GUI_FRAME_SNAPSHOT_JSON") t 'json)
    (neomacs--write-frame-snapshot (getenv "NEOMACS_GUI_FRAME_SNAPSHOT_TXT") t 'text))
  (run-at-time 0.3 nil (lambda () (kill-emacs 0))))
(run-at-time 0.5 nil #'neomacs-fill-column-stipple-start)
