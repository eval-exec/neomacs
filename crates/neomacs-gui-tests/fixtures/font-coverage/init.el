;;; Public font glyph coverage. -*- lexical-binding: t -*-
(require 'json)
(require 'emoji)
(require 'icons)
(defun font-coverage-strings (tree)
  (cond ((stringp tree) (list tree))
        ((consp tree) (append (font-coverage-strings (car tree)) (font-coverage-strings (cdr tree))))
        (t nil)))
(defun font-coverage-probe ()
  (switch-to-buffer (get-buffer-create "*font-coverage*"))
  (set-frame-font (font-spec :family "Spleen" :size 16))
  (insert "A█\n")
  (redisplay t)
  (let* ((entity (find-font (font-spec :family "Spleen")))
         (shown (font-at 2))
         (emoji-labels
          (let ((emoji--labels '(("Test" "A" "B" "█") ("Control" "A" "B" "█")))
                (emoji--all-bases nil)
                (emoji--names (make-hash-table :test 'equal)))
            (emoji--init)
            (cdr (car emoji--labels))))
         ;; Both editors filter the same label data, independent of the GNU
         ;; reference installation's Unicode data version.
         (full-labels (progn (load (getenv "NEOMACS_FONT_COVERAGE_LABELS") nil t)
                                  (emoji--init) (font-coverage-strings emoji--labels)))
         (result `((full-label-count . ,(length full-labels))
                   (full-labels . ,(vconcat full-labels))
                   (emoji-labels . ,(vconcat emoji-labels))
                   (emoji-icon . ,(substring-no-properties (or (icons--create 'emoji "🔽" nil) "")))
                   (entity-ascii . ,(if (font-has-char-p entity ?A) t :json-false))
                   (entity-block . ,(if (font-has-char-p entity ?█) t :json-false))
                   (shown-block . ,(if (font-has-char-p shown ?█) t :json-false))
                   (shown-missing . ,(if (font-has-char-p shown #x10ffff) t :json-false))
                   (shown-space . ,(if (font-has-char-p (font-at 1) ?\s) t :json-false))
                   (missing . ,(if (font-has-char-p entity #x10ffff) t :json-false))
                   (native-engine . ,(if (fboundp 'neomacs--write-frame-snapshot) t :json-false)))))
    (with-temp-file (getenv "NEOMACS_GUI_STATE_JSON")
      (insert (json-encode result))))
  (when (fboundp 'neomacs--write-frame-snapshot)
    (neomacs--write-frame-snapshot (getenv "NEOMACS_GUI_FRAME_SNAPSHOT_JSON") t 'json))
  (run-with-timer 1 nil (lambda () (kill-emacs 0))))
(run-with-timer 1 nil
                (lambda ()
                  (condition-case err (font-coverage-probe)
                    (error (with-temp-file (getenv "NEOMACS_GUI_STATE_JSON")
                             (insert (json-encode `((error . ,(format "%S" err))))))
                           (kill-emacs 1)))))
