(let* ((create (lambda (short long query)
                 (let ((read-symbol-shorthands (list (cons short long))))
                   (symbol-name (intern query (obarray-make))))))
       (describe (lambda (source)
                   (let ((bytes (string-as-unibyte source)))
                     (list (length source) (length bytes)
                           (multibyte-string-p source) (append bytes nil)))))
       (summarize (lambda (value)
                    (if (symbolp value) (list 'symbol (symbol-name value)) value)))
       (read-range (lambda (source start end)
                     (condition-case err
                         (let* ((read-symbol-shorthands nil)
                                (result (read-from-string source start end)))
                           (list 'ok (funcall summarize (car result)) (cdr result)))
                       (error (list 'error (car err) (cdr err))))))
       (read-direct (lambda (source)
                      (condition-case err
                          (let ((read-symbol-shorthands nil))
                            (list 'ok (funcall summarize (read source))))
                        (error (list 'error (car err) (cdr err))))))
       (mb-short (string 233))
       (ub-short (unibyte-string 195 169))
       (mb-query (string 233))
       (ub-query (unibyte-string 195 169))
       (terminal (funcall create mb-short (string-as-multibyte "?") ub-query))
       (cases (list
               (cons 'fully-backed (funcall create mb-short (string-as-multibyte "?a") mb-query))
               (cons 'one-character (funcall create mb-short (string-as-multibyte "?") mb-query))
               (cons 'initialized-terminal terminal)
               (cons 'terminal-symbol (funcall create mb-short (string-as-multibyte "a") ub-query))
               (cons 'declared-zero (funcall create ub-short (string-as-multibyte "a") mb-query))
               (cons 'unicode-backed (string-as-multibyte "?é"))
               (cons 'unibyte-backed (string-as-unibyte "?a"))
               (cons 'table-error (funcall create mb-short (string-as-multibyte "#^") ub-query))
               (cons 'table-error-physical (concat (string-as-multibyte "#^") (string 0)))
               (cons 'subtable-error (funcall create mb-short (string-as-multibyte "#^^") ub-query))
               (cons 'subtable-error-physical (concat (string-as-multibyte "#^^") (string 0)))
               (cons 'record-error (funcall create mb-short (string-as-multibyte "#s") ub-query))
               (cons 'record-error-physical (concat (string-as-multibyte "#s") (string 0)))
               (cons 'label-error (funcall create mb-short (string-as-multibyte "#1") ub-query))
               (cons 'label-error-physical (concat (string-as-multibyte "#1") (string 0)))
               )))
  (list
    (mapcar (lambda (entry)
              (list (car entry)
                    (mapcar (lambda (properties)
                              (let ((source (if properties
                                                (propertize (cdr entry) 'gdj-terminal-property 17)
                                              (cdr entry))))
                                (list properties (funcall describe source)
                                      (funcall read-range source 0 (length source))
                                      (funcall read-direct source))))
                            '(nil t)))) cases)
    (list 'end-zero (funcall read-range terminal 0 0))
    (list 'end-one (funcall read-range terminal 0 1))))
