(progn
  (defun gdj-ten-storage (s)
    (list (length s) (string-bytes s) (multibyte-string-p s)
          (append (string-as-unibyte s) nil)))
  (defun gdj-ten-result (object)
    (if (symbolp object)
        (list 'symbol (gdj-ten-storage (symbol-name object)))
      (list 'object object)))
  (defun gdj-ten-read (source mode start end)
    (let ((read-symbol-shorthands nil))
      (condition-case caught
          (if (eq mode 'from-string)
              (let ((pair (cond
                            ((and (null start) (null end)) (read-from-string source))
                            ((null end) (read-from-string source start))
                            (t (read-from-string source start end)))))
                (list 'ok (gdj-ten-result (car pair)) (cdr pair)))
            (list 'ok (gdj-ten-result
                       (if (eq mode 'standard-input)
                           (let ((standard-input source)) (read))
                         (read source)))))
        (error (list 'error (car caught))))))
  (defun gdj-ten-source (kind)
    (cond
     ((eq kind 'declared-two)
      (let ((read-symbol-shorthands
             (list (cons (unibyte-string #xc3 #xa9)
                         (string-to-multibyte "béa")))))
        (symbol-name (intern (string-to-multibyte "é") (obarray-make)))))
     ((eq kind 'ordinary-multibyte) (string-to-multibyte "béa"))
     ((eq kind 'ordinary-unibyte) (unibyte-string ?b #xc3 #xa9 ?a))
     (t (string-to-multibyte "ba"))))
  (defun gdj-ten-case (kind properties)
    (let ((source (gdj-ten-source kind)))
      (when properties (setq source (propertize source 'face 'bold)))
      (list
       kind properties (gdj-ten-storage source)
       ;; First request on this fresh source has no preceding string cursor.
       ;; For declared-two, the distance tie chooses backward from byte4 -> a.
       (list 'start-one (gdj-ten-read source 'from-string 1 nil))
       (list 'one-to-two (gdj-ten-read source 'from-string 1 2))
       (list 'default (gdj-ten-read source 'from-string nil nil))
       (list 'start-zero (gdj-ten-read source 'from-string 0 nil))
       (list 'first-two (gdj-ten-read source 'from-string 0 2))
       (list 'first-one (gdj-ten-read source 'from-string 0 1))
       (list 'negative-start (gdj-ten-read source 'from-string -1 nil))
       (list 'negative-end (gdj-ten-read source 'from-string nil -1))
       (list 'empty-bound (gdj-ten-read source 'from-string 0 0))
       (list 'at-end (gdj-ten-read source 'from-string (length source) nil))
       (list 'empty-at-end
             (gdj-ten-read source 'from-string (length source) (length source)))
       (list 'full-bound (gdj-ten-read source 'from-string 0 (length source)))
       (list 'read (gdj-ten-read source 'read nil nil))
       (list 'standard-input (gdj-ten-read source 'standard-input nil nil)))))
  (let (results)
    (dolist (kind '(declared-two ordinary-multibyte ordinary-unibyte ascii-multibyte))
      (dolist (properties '(nil t))
        (setq results (cons (gdj-ten-case kind properties) results))))
    (nreverse results)))
