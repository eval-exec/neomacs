(progn
(require 'bytecomp)
(defvar gdj-active-input nil)
(defun gdj-active-get (&optional c)
  (if c (setq gdj-active-input (cons c gdj-active-input))
    (let ((ch (car gdj-active-input))) (setq gdj-active-input (cdr gdj-active-input)) ch)))
(defun gdj-active-name (value)
  (let ((name (symbol-name value)))
    ;; Never append/aref the possibly malformed multibyte name itself.
    ;; Raw storage is observed only after SBYTES-bounded conversion.
    (list (length name) (string-bytes name)
      (append (string-as-unibyte name) nil)
      (multibyte-string-p name)
      (if (> (length name) 0) (text-properties-at 0 name) nil))))
(defun gdj-active-shape (name row mode shape)
  (let* ((read-symbol-shorthands
          (list 17 (cons "gdj-active-" 17)
            '("no-match-" . "unmatched-")
            (cons "gdj-active-" (concat "gdj-first-" row "-"))
            (cons "gdj-active-long-" (concat "gdj-late-" row "-"))))
         (source (concat name " "))
         (obarray-choice (if (eq mode 'custom) (obarray-make) nil)))
    (condition-case error-value
      (cond
        ((eq shape 'native)
          (let ((symbol (intern name obarray-choice)))
            (list 'ok (gdj-active-name symbol)
              (eq (intern-soft name obarray-choice) symbol)
              (eq (intern-soft symbol obarray-choice) symbol)
              (intern-soft (make-symbol (symbol-name symbol)) obarray-choice)
              (let ((read-symbol-shorthands nil))
                (eq (intern-soft (symbol-name symbol) obarray-choice) symbol)))))
        ((eq shape 'string)
          (let* ((pair (read-from-string source)) (symbol (car pair)))
            (list 'ok (gdj-active-name symbol) (cdr pair) (eq symbol (intern name)))))
        ((eq shape 'buffer)
          (with-temp-buffer
            (set-buffer-multibyte (multibyte-string-p source))
            (insert source) (goto-char 1)
            (let ((symbol (read (current-buffer))))
              (list 'ok (gdj-active-name symbol) (point) (eq symbol (intern name))))))
        (t
          (let* ((gdj-active-input (append source nil))
                 (function (if (eq shape 'compiled)
                   (byte-compile (lambda (&optional c) (gdj-active-get c)))
                   (lambda (&optional c) (gdj-active-get c))))
                 (symbol (read function)))
            (list 'ok (gdj-active-name symbol) gdj-active-input
                  (let ((read-symbol-shorthands nil))
                    (eq (intern-soft (symbol-name symbol)) symbol))))))
      (error (list 'error error-value)))))
(defun gdj-declared-order (tag input order stream)
  (let* ((short "gdj-order-") (long (concat "gdj-result-" tag "-"))
         (read-symbol-shorthands (list (cons short long)))
         (source (concat input " ")) first second cursor)
    (if (eq order 'native-first) (setq first (intern input)))
    (if (eq stream 'string)
        (let ((pair (read-from-string source)))
          (setq second (car pair) cursor (cdr pair)))
      (with-temp-buffer
        (set-buffer-multibyte (multibyte-string-p source))
        (insert source) (goto-char (point-min))
        (setq second (read (current-buffer)) cursor (point))))
    (unless first (setq first second second (intern input)))
    (list tag (gdj-active-name first) (gdj-active-name second)
      (eq first second) cursor
      (eq (intern-soft input) first)
      (let ((read-symbol-shorthands nil))
        (eq (intern-soft (symbol-name first)) first)))))
(defun gdj-declared-mixed (tag short long input properties)
  (when properties
    (setq short (propertize short 'face 'bold)
          long (propertize long 'help-echo "long-prefix")
          input (propertize input 'face 'italic)))
  (let* ((read-symbol-shorthands (list (cons short (concat "gdj-mixed-" tag "-" long))))
         (table (obarray-make)) (symbol (intern input table)))
    (list tag (gdj-active-name symbol)
      (eq (intern-soft input table) symbol)
      (eq (intern-soft symbol table) symbol)
      (let ((read-symbol-shorthands nil))
        (eq (intern-soft (symbol-name symbol) table) symbol)))))
(defun gdj-declared-zero (properties custom)
  ;; Safe nonnegative arithmetic: 1(long)-2(short)+1(query)=0 chars,
  ;; one initialized ASCII byte. Do not iterate its multibyte characters.
  (let* ((query (string-to-multibyte "é"))
         (short (unibyte-string 195 169))
         (long (string-to-unibyte "a"))
         (table (if custom (obarray-make) nil)))
    (when properties
      (setq query (propertize query 'face 'bold)
            short (propertize short 'face 'italic)
            long (propertize long 'help-echo "a")))
    (let* ((read-symbol-shorthands (list (cons short long)))
           (symbol (intern query table))
           (name (symbol-name symbol))
           (raw (string-as-unibyte name))
           (ordinary (intern raw table)))
      (list properties custom (gdj-active-name symbol)
        (eq symbol ordinary)
        (eq (intern-soft query table) symbol)
        (eq (intern-soft name table) symbol)
        (eq (intern-soft symbol table) symbol)
        (eq (intern-soft raw table) ordinary)
        (let ((read-symbol-shorthands nil))
          (eq (intern-soft name table) symbol))))))
(defun gdj-declared-raw-utf8 (properties custom)
  (let* ((tag (concat (if properties "props" "plain") "-" (if custom "custom" "global")))
         (short (concat "gdj-raw-" tag "-"))
         (long (concat "gdj-raw-result-" tag "-"))
         (unibyte-query (concat (string-to-unibyte short) (unibyte-string 195 169 195 169)))
         (multibyte-query (concat (string-to-multibyte short) (string-to-multibyte "éé")))
         (table (if custom (obarray-make) nil)))
    (when properties
      (setq unibyte-query (propertize unibyte-query 'face 'bold)
            multibyte-query (propertize multibyte-query 'face 'italic)))
    (let* ((read-symbol-shorthands (list (cons short long)))
           (raw-symbol (intern unibyte-query table))
           (unicode-symbol (intern multibyte-query table)))
      (list properties custom (gdj-active-name raw-symbol)
        (gdj-active-name unicode-symbol) (eq raw-symbol unicode-symbol)
        (eq (intern-soft unibyte-query table) raw-symbol)
        (eq (intern-soft multibyte-query table) unicode-symbol)
        (eq (intern-soft raw-symbol table) raw-symbol)
        (eq (intern-soft unicode-symbol table) unicode-symbol)
        (let ((read-symbol-shorthands nil))
          (list (eq (intern-soft (symbol-name raw-symbol) table) raw-symbol)
                (eq (intern-soft (symbol-name unicode-symbol) table) unicode-symbol)
                (eq (intern-soft (string-as-unibyte (symbol-name unicode-symbol)) table) raw-symbol)))))))
(list
(gdj-declared-zero nil nil)
(gdj-declared-zero nil t)
(gdj-declared-zero t nil)
(gdj-declared-zero t t)))
