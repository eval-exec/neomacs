(let ((l (list 1 2)) (vars (list 'a 'b)))
 (setcdr (cdr l) l) (setcdr (cdr vars) vars)
 (list (mapcar (lambda (head) (condition-case e (eval (cons head l))
                              (error (list (car e) (car (cadr e))))))
              '(list quote function setq + progn and (lambda (&rest x) x)))
       (condition-case e (eval (list 'let vars)) (error (list (car e) (car (cadr e)))))
       (condition-case e (eval (list 'let* vars)) (error (list (car e) (car (cadr e)))))
       (condition-case e (eval (read "(let #1=(1 2 3 . #1#))") t)
         (error (list (car e) (car (cadr e)))))
       (condition-case e (eval (read "(let* #1=(1 2 3 . #1#))") t)
         (error (list (car e) (cadr e))))))
