;; -*- lexical-binding: t -*-
;; N4 direct function-bound query twins. Refresh only with GNU 31.1.
(unless (and (string= emacs-version "31.1")
             (equal (getenv "NEOVM_ORACLE_MODE") "refresh")
             (equal (getenv "UPDATE_EXPECT") "1"))
  (error "N4 fboundp oracle requires GNU 31.1 and explicit refresh mode"))
(let ((symbol (make-symbol "nmjit-n4-fboundp"))
      (definition '(lambda () 73)))
  (prin1 (fboundp symbol)) (terpri)
  (fset symbol definition)
  (prin1 (fboundp symbol)) (terpri)
  (fmakunbound symbol)
  (prin1 (fboundp symbol)) (terpri)
  (fset symbol definition)
  (prin1 (fboundp symbol)) (terpri)
  (fset symbol nil)
  (prin1 (fboundp symbol)) (terpri)
  (fset symbol definition)
  (prin1 (fboundp symbol)) (terpri))
