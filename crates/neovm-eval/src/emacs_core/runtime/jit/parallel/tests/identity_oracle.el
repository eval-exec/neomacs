;; -*- lexical-binding: t -*-
(unless (and (string= emacs-version "31.1")
             (equal (getenv "NEOVM_ORACLE_MODE") "refresh")
             (equal (getenv "UPDATE_EXPECT") "1"))
  (error "N4 identity oracle requires GNU 31.1 and explicit refresh mode"))
(let* ((symbol (make-symbol "nmjit-n4-named"))
       (original (list 'lambda nil 73))
       (twin (list 'lambda nil 73)))
  (fset symbol original)
  (prin1 (eq (symbol-function symbol) original)) (terpri)
  (let ((selected (symbol-function symbol)))
    (fset symbol twin)
    (prin1 (funcall selected)) (terpri))
  (prin1 (eq (symbol-function symbol) original)) (terpri)
  (prin1 (eq (symbol-function symbol) twin)) (terpri)
  (fset symbol original)
  (prin1 (eq (symbol-function symbol) original)) (terpri)
  (fset symbol original)
  (prin1 (eq (symbol-function symbol) original)) (terpri)
  (fmakunbound symbol)
  (prin1 (condition-case nil (funcall symbol) (void-function 'void-function))) (terpri)
  (fset symbol 73)
  (prin1 (condition-case nil (funcall symbol) (invalid-function 'invalid-function))) (terpri))
