;;; elisp-benchmarks-tests.el --- ELB sampling protocol tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'json)

;; The upstream library normally declares this special variable; the lifecycle
;; tests stub the package loader, so declare the same test binding explicitly.
(defvar elb-bench-directory)

(defconst neomacs-perf-elb-test--fixtures
  (file-name-directory (or load-file-name buffer-file-name)))

;; Load definitions without running the upstream suite or scheduling its timer.
(let ((noninteractive nil))
  (cl-letf (((symbol-function 'run-at-time) (lambda (&rest _) nil)))
    (load (expand-file-name "elisp-benchmarks.el"
                            neomacs-perf-elb-test--fixtures) nil nil t)))

(ert-deftest neomacs-perf-elb-gate-waits-for-complete-ack-before-returning ()
  (let ((commands nil) (waits 0)
        (neomacs-perf-elb--profile-gate-response ""))
    (cl-letf (((symbol-function 'neomacs-perf-elb--profile-gate-connect)
               (lambda () 'elb-test-process))
              ((symbol-function 'process-send-string)
               (lambda (process text)
                 (should (eq process 'elb-test-process))
                 (push text commands)))
              ((symbol-function 'process-live-p) (lambda (_) t))
              ((symbol-function 'accept-process-output)
               (lambda (process seconds milliseconds just-this-one)
                 (should (eq process 'elb-test-process))
                 (should (= seconds 0.05))
                 (should-not milliseconds)
                 (should (= just-this-one 1))
                 (setq waits (1+ waits))
                 (neomacs-perf-elb--profile-gate-filter
                  process (if (= (% waits 2) 1) "ac" "k\n")))))
      (neomacs-perf-elb--sampling-command "enable")
      (should (= waits 2))
      (neomacs-perf-elb--sampling-command "disable")
      (should (= waits 4))
      (should (equal (nreverse commands) '("enable\n" "disable\n"))))))

(ert-deftest neomacs-perf-elb-gate-rejects-malformed-or-extra-ack-bytes ()
  (dolist (response '("nak\n" "ack\nextra\n"))
    (let ((neomacs-perf-elb--profile-gate-response ""))
      (cl-letf (((symbol-function 'neomacs-perf-elb--profile-gate-connect)
                 (lambda () 'elb-test-process))
                ((symbol-function 'process-send-string)
                 (lambda (_process _text)
                   (neomacs-perf-elb--profile-gate-filter nil response))))
        (should-error (neomacs-perf-elb--sampling-command "enable"))))))

(ert-deftest neomacs-perf-elb-gate-rejects-disconnection-and-timeout ()
  (let ((neomacs-perf-elb--profile-gate-response ""))
    (cl-letf (((symbol-function 'neomacs-perf-elb--profile-gate-connect)
               (lambda () 'elb-test-process))
              ((symbol-function 'process-send-string) (lambda (&rest _) nil))
              ((symbol-function 'process-live-p) (lambda (_) nil)))
      (should-error (neomacs-perf-elb--sampling-command "enable"))))
  (let ((neomacs-perf-elb--profile-gate-response "")
        (times '(0.0 31.0)))
    (cl-letf (((symbol-function 'neomacs-perf-elb--profile-gate-connect)
               (lambda () 'elb-test-process))
              ((symbol-function 'process-send-string) (lambda (&rest _) nil))
              ((symbol-function 'float-time) (lambda (&rest _) (pop times))))
      (should-error (neomacs-perf-elb--sampling-command "disable")))))

(ert-deftest neomacs-perf-elb-gate-validates-a-present-port ()
  (cl-letf (((symbol-function 'getenv) (lambda (_) "0")))
    (should-error (neomacs-perf-elb--profile-gate-connect))))

(defun neomacs-perf-elb-test--run-fixture (fail-workload &optional demoted-stage fail-enable)
  (let* ((root (expand-file-name "../../../tmp" neomacs-perf-elb-test--fixtures))
         (_ (make-directory root t))
         (directory (make-temp-file (expand-file-name "elb-protocol-" root) t))
         (result-path (expand-file-name "result.json" directory))
         (report-path (expand-file-name "report.txt" directory))
         (sentinel-path (expand-file-name "completed" directory))
         (events nil) (exit-code nil)
         (cpu-times '(10 70)) (wall-times '(1.0 1.000080))
         (gcs-done 12) (gc-elapsed 0.000100)
         (gc-cons-threshold most-positive-fixnum)
         (neomacs-perf-elb--profile-gate-process nil)
         (elb-bench-directory directory))
    (unwind-protect
        (cl-letf (((symbol-function 'getenv)
                   (lambda (name &optional _frame)
                     (cdr (assoc name
                                 `(("NEOMACS_PERF_RESULT" . ,result-path)
                                   ("SENTINEL" . ,sentinel-path)
                                   ("NEOMACS_PERF_ELB_DIR" . ,directory)
                                   ("NEOMACS_PERF_ITERATIONS" . "2")
                                   ("NEOMACS_PERF_ELB_REPORT" . ,report-path))))))
                  ((symbol-function 'require) (lambda (&rest _) t))
                  ((symbol-function 'directory-files)
                   (lambda (&rest _) (make-list 17 "benchmark.el")))
                  ((symbol-function 'elisp-benchmarks-run)
                   (lambda (_selection compile _repetitions)
                     (push (if compile 'prepare 'workload) events)
                     (when (eq demoted-stage (if compile 'prepare 'workload))
                       ;; Match upstream's error demotion: the message is
                       ;; emitted by an error handler before a later table.
                       (condition-case demoted-error
                           (error "injected demoted suite error")
                         (error
                          (message (if compile "Error loading: %S"
                                     "Error running: %S")
                                   demoted-error))))
                     (unless compile
                       (when fail-workload (error "injected suite error"))
                       (setq gcs-done (+ gcs-done 3)
                             gc-elapsed (+ gc-elapsed 0.000040))
                       (message "upstream results table"))))
                  ((symbol-function 'neomacs-perf-elb--sampling-command)
                   (lambda (command)
                     (push command events)
                     (when (and fail-enable (equal command "enable"))
                       (setq gcs-done (1+ gcs-done)
                             gc-elapsed (+ gc-elapsed 0.000010))
                       (error "injected enable ACK failure"))))
                  ((symbol-function 'neomacs-perf-elb--cpu-us)
                   (lambda () (pop cpu-times)))
                  ((symbol-function 'float-time)
                   (lambda (&rest _) (or (pop wall-times) 1.000080)))
                  ((symbol-function 'kill-emacs)
                   (lambda (code) (setq exit-code code))))
          (neomacs-perf-elb--run)
          (should (file-exists-p sentinel-path))
          (list (with-temp-buffer
                  (insert-file-contents result-path)
                  (json-parse-buffer :object-type 'alist :null-object nil))
                (nreverse events) exit-code
                (with-temp-buffer
                  (insert-file-contents report-path)
                  (buffer-string))))
      (delete-directory directory t))))

(ert-deftest neomacs-perf-elb-fixture-prepares-before-one-common-interval ()
  (pcase-let ((`(,result ,events ,exit-code ,report)
               (neomacs-perf-elb-test--run-fixture nil)))
    (should (equal events '(prepare "enable" workload workload "disable")))
    (should (= exit-code 0))
    (should (equal (alist-get 'status result) "ok"))
    (should (= (alist-get 'iterations result) 2))
    (should (= (alist-get 'elapsed_us result) 60))
    (should (= (alist-get 'elapsed_wall_us result) 80))
    (should (= (alist-get 'gcs_done_start result) 12))
    (should (= (alist-get 'gcs_done_end result) 18))
    (should (= (alist-get 'gcs_done_delta result) 6))
    (should (= (alist-get 'gc_elapsed_us_delta result) 80))
    (should (equal report "upstream results table\n"))))

(ert-deftest neomacs-perf-elb-fixture-disables-sampling-on-workload-error ()
  (pcase-let ((`(,result ,events ,exit-code ,_report)
               (neomacs-perf-elb-test--run-fixture t)))
    (should (equal events '(prepare "enable" workload "disable")))
    (should (= exit-code 2))
    (should (equal (alist-get 'status result) "error"))
    (should (= (alist-get 'iterations result) 0))
    (should (= (alist-get 'elapsed_wall_us result) 0))
    (should (string-match-p "injected suite error" (alist-get 'error result)))))

(ert-deftest neomacs-perf-elb-fixture-cleans-up-a-failed-enable-ack ()
  (pcase-let ((`(,result ,events ,exit-code ,_report)
               (neomacs-perf-elb-test--run-fixture nil nil t)))
    (should (equal events '(prepare "enable" "disable")))
    (should (= exit-code 2))
    (should (equal (alist-get 'status result) "error"))
    (should (= (alist-get 'iterations result) 0))
    (should (= (alist-get 'elapsed_wall_us result) 0))
    (should (= (alist-get 'gcs_done_start result) 12))
    (should (= (alist-get 'gcs_done_end result) 13))
    (should (= (alist-get 'gcs_done_delta result) 1))
    (should (= (alist-get 'gc_elapsed_us_delta result) 10))
    (should (string-match-p "injected enable ACK failure"
                            (alist-get 'error result)))))

(ert-deftest neomacs-perf-elb-fixture-rejects-demoted-errors-before-later-results ()
  (dolist (stage '(prepare workload))
    (pcase-let ((`(,result ,events ,exit-code ,report)
                 (neomacs-perf-elb-test--run-fixture nil stage)))
      (should (equal events
                     (if (eq stage 'prepare) '(prepare)
                       '(prepare "enable" workload "disable"))))
      (should (= exit-code 2))
      (should (equal (alist-get 'status result) "error"))
      (should (= (alist-get 'iterations result) 0))
      (should (= (alist-get 'elapsed_wall_us result) 0))
      (should (string-match-p "injected demoted suite error"
                              (alist-get 'error result)))
      (should (string-match-p (if (eq stage 'prepare) "Error loading:"
                               "Error running:")
                              (alist-get 'error result)))
      (should-not (string-match-p "upstream results table" report)))))

