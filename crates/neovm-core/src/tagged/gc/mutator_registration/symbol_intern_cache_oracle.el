;; -*- lexical-binding: t -*-
(unless (and (string= emacs-version "31.1")
             (equal (getenv "NEOVM_ORACLE_MODE") "refresh")
             (equal (getenv "UPDATE_EXPECT") "1"))
  (error "C5 cache oracle requires GNU 31.1 explicit refresh"))
(setq p3sym-c5-cache-value 73)
(fset 'p3sym-c5-cache-function (lambda () 73))
(let ((reader (byte-compile '(lambda () p3sym-c5-cache-value)))
      (caller (byte-compile '(lambda () (p3sym-c5-cache-function)))))
  (prin1 (list (funcall reader) (funcall caller))) (terpri)
  (intern (copy-sequence "p3sym-c5-cache-fresh"))
  (prin1 (list (funcall reader) (funcall caller))) (terpri)
  (setq p3sym-c5-cache-value 97)
  (prin1 (list (funcall reader) (funcall caller))) (terpri))
