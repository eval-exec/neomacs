;; -*- lexical-binding: t -*-
(unless (and (string= emacs-version "31.1")
             (equal (getenv "NEOVM_ORACLE_MODE") "refresh")
             (equal (getenv "UPDATE_EXPECT") "1"))
  (error "N4 unary oracle requires GNU 31.1 and explicit refresh mode"))
(let* ((symbol (make-symbol "nmjit-n4-unary"))
       (original (list 'lambda '(arg) 73))
       (replacement (list 'lambda '(arg) 97))
       (input (list 1)))
  (fset symbol original)
  (prin1 (eq (symbol-function symbol) original)) (terpri)
  (let ((selected (symbol-function symbol)))
    (fset symbol replacement)
    (prin1 (funcall selected nil)) (terpri))
  (prin1 (eq (symbol-function symbol) original)) (terpri)
  (prin1 (eq (symbol-function symbol) replacement)) (terpri)
  (prin1 (funcall symbol nil)) (terpri)
  (prin1 (mapcar original input)) (terpri)
  (prin1 (eq (mapc original input) input)) (terpri)
  (prin1 (condition-case nil (funcall symbol)
           (wrong-number-of-arguments 'wrong-number-of-arguments))) (terpri))
