;; -*- lexical-binding: t -*-
;; C5 language twins; only GNU 31.1 explicit refreshes create expectations.
(unless (and (string= emacs-version "31.1")
             (equal (getenv "NEOVM_ORACLE_MODE") "refresh")
             (equal (getenv "UPDATE_EXPECT") "1"))
  (error "C5 oracle requires GNU 31.1 and explicit refresh mode"))
(defun p3sym-c5-out (value) (prin1 value) (terpri))
(let* ((name (copy-sequence "p3sym-c5-fresh"))
       (equal-name (copy-sequence name))
       (before (intern-soft name))
       (symbol (intern name)))
  (p3sym-c5-out before)
  (p3sym-c5-out (eq (symbol-name symbol) name))
  (p3sym-c5-out (eq (intern equal-name) symbol))
  (p3sym-c5-out (eq (intern-soft equal-name) symbol))
  (p3sym-c5-out (list (eq (symbol-name symbol) name)
                     (eq (symbol-name symbol) equal-name)))
  (p3sym-c5-out (list (boundp symbol) (fboundp symbol) (symbol-plist symbol)))
  (let ((count 0))
    (mapatoms (lambda (member) (when (eq member symbol) (setq count (1+ count)))))
    (p3sym-c5-out count)))
(let* ((left (copy-sequence "p3sym-c5-distinct-left"))
       (right (copy-sequence "p3sym-c5-distinct-right"))
       (a (intern left)) (b (intern right)) (count 0))
  (p3sym-c5-out (eq a b))
  (p3sym-c5-out (list (eq (intern-soft left) a) (eq (intern-soft right) b)))
  (mapatoms (lambda (member) (when (or (eq member a) (eq member b))
                              (setq count (1+ count)))))
  (p3sym-c5-out count))
(let* ((name (copy-sequence "p3sym-c5-soft-only-miss")) (count 0))
  (dotimes (_ 3) (intern-soft name))
  (p3sym-c5-out (intern-soft name))
  (mapatoms (lambda (member) (when (equal (symbol-name member) name)
                              (setq count (1+ count)))))
  (p3sym-c5-out count))
(let* ((name (copy-sequence "p3sym-c5-name-properties"))
       (_ (put-text-property 0 1 'p3sym-c5-property 73 name))
       (symbol (intern name)))
  (p3sym-c5-out (eq (symbol-name symbol) name))
  (p3sym-c5-out (get-text-property 0 'p3sym-c5-property (symbol-name symbol)))
  (let ((other (copy-sequence name)))
    (put-text-property 0 1 'p3sym-c5-property 97 other)
    (intern other)
    (p3sym-c5-out (get-text-property 0 'p3sym-c5-property (symbol-name symbol)))))
(let* ((first (string-as-unibyte "p3sym-c5-ascii-name"))
       (second (string-as-multibyte first)) (symbol (intern first)))
  (p3sym-c5-out (eq (intern second) symbol))
  (p3sym-c5-out (list (eq (symbol-name symbol) first)
                     (multibyte-string-p (symbol-name symbol)))))
(let* ((name (copy-sequence "p3sym-c5-λ-name")) (symbol (intern name)))
  (p3sym-c5-out (list (eq (symbol-name symbol) name)
                     (eq (intern-soft (copy-sequence name)) symbol))))
(let* ((name (copy-sequence "p3sym-c5-uninterned-gap"))
       (private (make-symbol name)))
  (p3sym-c5-out (intern-soft name))
  (let ((canonical (intern name)))
    (p3sym-c5-out (list (eq canonical private)
                       (eq (symbol-name canonical) name)
                       (eq (intern-soft name) canonical)))))
(let* ((symbol (intern "p3sym-c5-global-initially-unbound")))
  (p3sym-c5-out (boundp symbol))
  (set symbol 97)
  (p3sym-c5-out (list (boundp symbol) (symbol-value symbol)))
  (makunbound symbol)
  (p3sym-c5-out (boundp symbol)))
(let* ((name (copy-sequence "p3sym-c5-name-retained-by-symbol"))
       (symbol (intern name)))
  (setq name nil)
  (garbage-collect)
  (p3sym-c5-out (eq (intern-soft (symbol-name symbol)) symbol)))
