(let* ((query (make-string 1 233))
        (read-symbol-shorthands
         (list (cons (encode-coding-string query 'utf-8 t)
                     (concat (make-string 2 233) "a"))))
        (source (symbol-name (intern query (obarray-make))))
        (char-width-table (copy-sequence char-width-table)))
   (aset char-width-table 233 7)
   (let ((wide (string-width source)))
     (aset char-width-table 233 3)
     (let ((narrow (string-width source)))
       (aset char-width-table 233 0)
       (let ((zero (string-width source))
             (standard-display-table (make-display-table)))
         (aset standard-display-table 233 [?x ?x])
         (list (length source) (string-bytes source)
               (multibyte-string-p source)
               wide narrow zero (string-width source))))))
