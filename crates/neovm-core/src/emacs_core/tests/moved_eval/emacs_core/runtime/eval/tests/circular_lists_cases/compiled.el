(progn (require 'bytecomp)
 (let ((l (list 1 2))
       (f (byte-compile (lambda (fn x) (apply fn x))))
       (c (byte-compile (lambda (x) (concat x))))
       (r (byte-compile (lambda (x) (rassoc "missing" x)))))
  (setcdr (cdr l) l)
  (list (condition-case e (funcall f #'list l) (error (list (car e) (car (cadr e)))))
        (condition-case e (funcall c l) (error (list (car e) (car (cadr e)))))
        (condition-case e (funcall r l) (error (list (car e) (car (cadr e))))))))
