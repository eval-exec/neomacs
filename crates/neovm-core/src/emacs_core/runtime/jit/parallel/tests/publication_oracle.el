;; -*- lexical-binding: t -*-
(unless (and (string= emacs-version "31.1")
             (equal (getenv "NEOVM_ORACLE_MODE") "refresh")
             (equal (getenv "UPDATE_EXPECT") "1"))
  (error "N4 publication oracle requires GNU 31.1 and explicit refresh mode"))
(let* ((name (copy-sequence "nmjit-n4-publication-fresh-name"))
       (equal-name (copy-sequence name))
       (named (make-symbol "nmjit-n4-publication-nullary"))
       (callback (make-symbol "nmjit-n4-publication-unary"))
       (old (list 'lambda nil 73))
       (new (list 'lambda nil 97)))
  (prin1 (intern-soft name)) (terpri)
  (fset named old)
  (fset callback (list 'lambda '(arg) 73))
  (prin1 (mapcar callback (list 7))) (terpri)
  (let ((selected (symbol-function named)))
    (fset named new)
    (fset callback (list 'lambda '(arg) 97))
    (garbage-collect)
    (garbage-collect)
    (prin1 (funcall selected)) (terpri))
  (prin1 (funcall named)) (terpri)
  (prin1 (eq (symbol-function named) old)) (terpri)
  (prin1 (mapcar callback (list 7))) (terpri)
  (let ((fresh (intern name)))
    (prin1 (eq fresh (intern equal-name))) (terpri)
    (prin1 (fboundp fresh)) (terpri)
    (prin1 (boundp fresh)) (terpri)
    (set fresh 73)
    (prin1 (symbol-value fresh)) (terpri)
    (prin1 (boundp fresh)) (terpri)
    (prin1 (eq fresh (intern-soft equal-name))) (terpri)))
