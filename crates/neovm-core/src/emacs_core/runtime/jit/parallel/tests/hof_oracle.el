;; -*- lexical-binding: t -*-
(unless (and (string= emacs-version "31.1")
             (equal (getenv "NEOVM_ORACLE_MODE") "refresh")
             (equal (getenv "UPDATE_EXPECT") "1"))
  (error "N4 mapping oracle requires GNU 31.1 and explicit refresh mode"))
(let* ((symbol (make-symbol "nmjit-n4-mapping"))
       (original (list 'lambda '(arg) 73))
       (replacement (list 'lambda '(arg) 97))
       (input (list 7)))
  (fset symbol original)
  (prin1 (mapcar symbol input)) (terpri)
  (prin1 (eq (mapc symbol input) input)) (terpri)
  (prin1 (eq (mapcar symbol input) input)) (terpri)
  (fset symbol replacement)
  (prin1 (mapcar symbol input)) (terpri)
  (prin1 (mapcar original input)) (terpri)
  (prin1 (mapc original input)) (terpri))
