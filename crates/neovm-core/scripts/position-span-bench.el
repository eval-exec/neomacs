;;; position-span-bench.el --- local position conversion -*- lexical-binding: t; -*-
;; Run with: taskset -c CORE EDITOR -Q --batch -l position-span-bench.el
;; Compare the same four positions in mixed text, all-ASCII text, and dense
;; multibyte text. Each checked sample performs 400,000 conversions.
(require 'bytecomp)
(defun position-span-char-loop (n)
  (let (answer)
    (dotimes (_ n)
      (setq answer (+ (position-bytes 6001) (position-bytes 8001)
                      (position-bytes 10001) (position-bytes 12001))))
    answer))
(defun position-span-byte-loop (n)
  (let (answer)
    (dotimes (_ n)
      (setq answer (+ (byte-to-position 6002) (byte-to-position 8002)
                      (byte-to-position 10002) (byte-to-position 12002))))
    answer))
(dolist (function '(position-span-char-loop position-span-byte-loop))
  (byte-compile function)
  (unless (byte-code-function-p (symbol-function function))
    (error "Expected bytecode for %s" function)))
(set-buffer (get-buffer-create "*position-span-bench*"))
(dolist (case '((ascii-span 36008 36004)
                (ascii-control 36004 36008)
                (multibyte-control 108004 12004)))
  (erase-buffer)
  (insert (pcase (car case)
            ('ascii-span (concat "é" (make-string 20000 ?a) "日"))
            ('ascii-control (make-string 20002 ?a))
            ('multibyte-control (make-string 20002 ?日))))
  (dolist (test (list (cons 'position-span-char-loop (nth 1 case))
                     (cons 'position-span-byte-loop (nth 2 case))))
    (dotimes (_ 40) (funcall (car test) 1000))
    (let (samples)
      (dotimes (_ 7)
        (let* ((start (float-time))
               (value (funcall (car test) 100000))
               (elapsed (- (float-time) start)))
          (unless (equal value (cdr test))
            (error "Wrong result for %s/%s: %S" (car case) (car test) value))
          (push (* elapsed 1e6) samples)))
      (princ (format "BENCH %s-%s n=100000 median_us=%.1f samples_us=%S\n"
                     (car case) (car test)
                     (nth 3 (sort (copy-sequence samples) #'<))
                     (nreverse samples))))))
