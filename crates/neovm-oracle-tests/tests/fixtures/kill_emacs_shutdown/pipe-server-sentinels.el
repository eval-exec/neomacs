;;; -*- lexical-binding: t; -*-
(setq shutdown-probe-root (getenv "SHUTDOWN_PROBE_ROOT"))
(setq probe-log (expand-file-name "events.log" shutdown-probe-root))
(setq probe-auto (expand-file-name "autosave" shutdown-probe-root))
(setq auto-save-list-file-name nil)
(defun probe-record (line)
  (let ((coding-system-for-write 'utf-8-unix))
    (write-region (concat line "\n") nil probe-log t 'silent)))
(defun probe-sentinel (process _message)
  (probe-record (concat "sentinel:" (process-name process))))
(defun probe-server (name)
  (make-network-process :name name :server t :host "127.0.0.1"
                        :family 'ipv4 :service t :noquery t
                        :sentinel #'probe-sentinel))
(delete-process (make-pipe-process :name "control-pipe" :noquery t :sentinel #'probe-sentinel))
(delete-process (probe-server "control-server"))
(setq probe-old-pipe (make-pipe-process :name "old-pipe" :noquery t :sentinel #'probe-sentinel))
(setq probe-old-server (probe-server "old-server"))
(defun probe-handler (operation &rest args)
  (if (eq operation 'write-region)
      (progn
        (probe-record (format "autosave-old-status:%S/%S"
                              (process-status probe-old-pipe)
                              (process-status probe-old-server)))
        (delete-process (probe-server "new-server"))
        (delete-process (make-pipe-process :name "new-pipe" :noquery t :sentinel #'probe-sentinel))
        (probe-record "after-new-delete")
        nil)
    (let ((inhibit-file-name-handlers (cons 'probe-handler inhibit-file-name-handlers))
          (inhibit-file-name-operation operation))
      (apply operation args))))
(setq file-name-handler-alist (list (cons (concat "\\`" (regexp-quote probe-auto) "\\'") 'probe-handler)))
(setq kill-emacs-hook (list (lambda () (probe-record "kill-hook"))))
(set-buffer (get-buffer-create "shutdown-sentinel-buffer"))
(setq buffer-auto-save-file-name probe-auto)
(insert "modified")
(kill-emacs 0)
