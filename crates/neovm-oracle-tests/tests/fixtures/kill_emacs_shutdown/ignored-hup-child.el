;;; -*- lexical-binding: t; -*-
(setq shutdown-probe-root (getenv "SHUTDOWN_PROBE_ROOT"))
(when (getenv "SHUTDOWN_EXPECT_FOREGROUND_DAEMON")
  (unless (and (daemonp) (not noninteractive))
    (error "Expected an interactive foreground daemon, not batch mode")))
(setq auto-save-list-file-name nil)
(setq shutdown-probe-child
      (make-process :name "ignore-hup-child" :buffer nil :noquery t
                    :connection-type (if (getenv "SHUTDOWN_PROBE_PTY") 'pty 'pipe)
                    :stderr (when (getenv "SHUTDOWN_PROBE_SPLIT_STDERR")
                              (make-pipe-process :name "ignore-hup-stderr" :noquery t))
                    :command (list (getenv "SHUTDOWN_CHILD_PROGRAM")
                                   (getenv "SHUTDOWN_CHILD_HELPER")
                                   shutdown-probe-root)))
(let ((deadline (+ (float-time) 5.0)))
  (while (and (not (file-exists-p (expand-file-name "child.ready" shutdown-probe-root)))
              (< (float-time) deadline))
    (accept-process-output shutdown-probe-child 0.01)))
(unless (file-exists-p (expand-file-name "child.ready" shutdown-probe-root))
  (error "Child did not become ready"))
(let ((status (with-temp-buffer
                (insert-file-contents (format "/proc/%d/status" (process-id shutdown-probe-child)))
                (buffer-string))))
  (unless (and (string-match "^SigIgn:[ \t]+\\([0-9a-f]+\\)" status)
               (/= 0 (logand 1 (string-to-number (match-string 1 status) 16))))
    (error "Child is not ignoring HUP")))
(princ "HUP-IGNORED=t\n")
(write-region "ready\n" nil (getenv "SHUTDOWN_READY") nil 'silent)
(let ((deadline (+ (float-time) 5.0)))
  (while (and (not (file-exists-p (getenv "SHUTDOWN_GO")))
              (< (float-time) deadline))
    (sleep-for 0.01)))
(unless (file-exists-p (getenv "SHUTDOWN_GO"))
  (error "Supervisor did not release GO"))
(when (getenv "SHUTDOWN_PROBE_DELETE_CONTROL")
  (delete-process shutdown-probe-child)
  (princ "EXPLICIT-DELETE-CONTROL=t\n"))
(kill-emacs 0)
