(let* ((file-name-handler-alist nil)
       (create-lockfiles t)
       (file-name-coding-system 'no-conversion)
       (dir (make-temp-file "threadsig-late-threat-" t))
       (file (expand-file-name "visited" dir))
       (lock-a (expand-file-name "lock-a" dir))
       (lock-b (expand-file-name "lock-b" dir))
       (alias (string-as-unibyte (copy-sequence lock-a)))
       (buffer (generate-new-buffer " *threadsig-late-threat*"))
       (old-make (symbol-function 'make-lock-file-name))
       (old-threat (symbol-function 'userlock--ask-user-about-supersession-threat))
       events)
  (unwind-protect
      (progn
        (write-region "seed" nil file nil 'silent)
        (with-current-buffer buffer
          (setq buffer-file-name (copy-sequence file)
                buffer-file-truename (copy-sequence file))
          (set-visited-file-modtime '(1 0 0 0))
          (let ((inhibit-modification-hooks t)) (set-buffer-modified-p nil)))
        (fset 'make-lock-file-name (lambda (_expanded) alias))
        (fset 'userlock--ask-user-about-supersession-threat
              (lambda (received-file)
                (setq events (cons (list 'threat (string-equal received-file file)
                                         (not (multibyte-string-p alias))) events))
                (aset alias (1- (length alias)) ?b)
                (garbage-collect)
                nil))
        (lock-file file)
        (unless events (error "Native supersession callback was not reached"))
        (list (nreverse events) (string-equal alias lock-b)
              (not (null (file-symlink-p lock-a)))
              (not (null (file-symlink-p lock-b)))))
    (fset 'make-lock-file-name old-make)
    (fset 'userlock--ask-user-about-supersession-threat old-threat)
    (when (buffer-live-p buffer)
      (with-current-buffer buffer
        (setq buffer-file-name nil buffer-file-truename nil)
        (let ((inhibit-modification-hooks t)) (set-buffer-modified-p nil)))
      (kill-buffer buffer))
    (delete-directory dir t)))
