;; UNEXECUTED SOURCE-ONLY PROBE. No observed result or regression grade.
(let* ((file-name-handler-alist nil)
       (name (copy-sequence (string-as-unibyte "/threadsig-expand/leaf")))
       (directory (string-as-unibyte "/"))
       (marker (vector 'payload))
       result before)
  (put-text-property 0 1 'threadsig-payload marker name)
  (setq result (expand-file-name name directory)
        before (list (eq result name)
                     (equal result name)
                     (eq (get-text-property 0 'threadsig-payload result) marker)
                     (multibyte-string-p name)
                     (multibyte-string-p result)))
  (aset result (1- (length result)) ?X)
  (put-text-property 0 1 'threadsig-mutated 'yes result)
  (list before (substring-no-properties name)
        (get-text-property 0 'threadsig-mutated name)))
