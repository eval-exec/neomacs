# Controlled entries: installed databases differ between Linux and macOS.
neo-app-common|Neomacs common attribute fixture,
    colors#256, op=\E[39;49m,
    smul=\E[4m, rmul=\E[24m, bold=\E[1m, sitm=\E[3m, smso=\E[7m,
    sgr0=\E[0m, smxx=\E[9m,
neo-app-styled|Neomacs extended attribute fixture,
    Smulx=\E[4:%p1%dm, use=neo-app-common,
neo-app-colon|Neomacs colon palette fixture,
    setaf=\E[38:5:%p1%dm, use=neo-app-common,
neo-app-linux16|Neomacs reset-brightness palette fixture,
    colors#16, setaf=\E[3%p1%d;22m, setab=\E[4%p1%d;25m,
    use=neo-app-common,
neo-app-svr4|Neomacs alternate palette order fixture,
    colors#8, setf=\E[3%p1%{3}%+%dm, use=neo-app-common,
neo-app-separate|Neomacs separate RGB fixture,
    setrgbf=\E[38:2:%p1%d:%p2%d:%p3%dm,
    setrgbb=\E[48:2:%p1%d:%p2%d:%p3%dm, use=neo-app-common,
neo-app-packed|Neomacs packed RGB fixture,
    RGB,
    setaf=\E[38:2::%p1%{65536}%/%d:%p1%{256}%/%{255}%&%d:%p1%{255}%&%dm,
    use=neo-app-common,
neo-app-indexed|Neomacs indexed palette fixture,
    setaf=\E[%?%p1%{8}%<%t3%p1%d%e%p1%{16}%<%t9%p1%{8}%-%d%e38;5;%p1%d%;m,
    use=neo-app-common,
neo-app-normalized-reset|Neomacs termcap reset normalization fixture,
    sgr0=\E[m^O, smacs=^N, rmacs=^O,
    sgr=\E[0%?%p1%p6%|%t;1%;%?%p2%t;4%;%?%p1%p3%|%t;7%;%?%p4%t;5%;m%?%p9%t\016%e\017%;,
    use=neo-app-common,
neo-app-custom-reset|Neomacs custom reset fixture,
    sgr0=CUSTOM-RESET, rmul=UNDERLINE-OFF, use=neo-app-common,
neo-app-padding|Neomacs padded control fixture,
    cols#80, lines#24, npc,
    cup=\E[%i%p1%d;%p2%dH$<0/>, clear=CLEAR$<1*/>,
    smso=ON$<1/>, rmso=OFF$<1/>,
