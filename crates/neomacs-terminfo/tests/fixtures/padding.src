neo-padding|Neomacs padding bytes,
    cols#80, lines#24, colors#8, pb#1, pad=.,
neo-padding-flow|Neomacs flow control suppresses optional padding,
    xon, use=neo-padding,
neo-padding-high|Neomacs padding baud threshold,
    pb#19200, use=neo-padding,
neo-padding-sleep|Neomacs padding without pad character,
    npc, use=neo-padding,
neo-padding-other|Neomacs different padding character,
    pad=+, use=neo-padding,
