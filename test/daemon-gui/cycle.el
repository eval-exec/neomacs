
(defun native-proof-retained-state ()
  (let* ((state (ewm-get-debug-state-module))
         (holders (alist-get 'keyboard_capture_holders state)))
    (unless (and (= (alist-get 'emacs_pid state) native-proof-pid) (alist-get 'debug_mode state)
                 (cl-find-if (lambda (holder) (equal (cadr holder) "native-retained-state")) holders))
      (error "Native debug/capture state lost: %S" state))
    state))
(native-proof-retained-state)
(garbage-collect)
(native-proof-retained-state)
;; Failed explicit socket open must not publish a frame or consume winit's
;; successful singleton; this happens after real compositor readiness.
(setq native-proof-frames-before (frame-list))
(setq native-proof-create-hooks nil)
(defun native-proof-created (frame) (push frame native-proof-create-hooks))
(add-hook 'after-make-frame-functions #'native-proof-created)
(unless (condition-case nil
            (progn (make-frame '((window-system . neo) (display . "missing-native-socket"))) nil)
          (error t))
  (error "Bad explicit display unexpectedly opened"))
(unless (equal native-proof-frames-before (frame-list)) (error "Phantom frame on failed open"))
(when native-proof-create-hooks (error "Frame creation hook ran on failed open"))
;; Connection-only updates before first native frame exceed capacity64.
(x-open-connection "wayland-ewm-proof")
(dotimes (_ 256) (neomacs--effect-set 'window-resize :enabled t))

(setq native-proof-first (make-frame '((window-system . neo) (display . "wayland-ewm-proof") (name . "native-first") (width . 70) (height . 20))))
(unless (eq (car native-proof-create-hooks) native-proof-first) (error "Successful creation hook missing"))
(select-frame-set-input-focus native-proof-first)
(set-window-buffer (frame-selected-window native-proof-first) native-proof-buffer)
(redisplay t)
(native-proof-wait (lambda () (= (native-proof-mapped-count) 1)))
(native-proof-wait
 (lambda ()
   (cl-find-if (lambda (event)
                 (and (consp event) (eq (car event) 'new)
                      (= (or (alist-get 'pid (cdr event)) -1) native-proof-pid)))
               native-proof-events)))
(setq native-proof-counts (append native-proof-counts (list (native-proof-mapped-count))))
(setq native-proof-second (make-frame '((window-system . neo) (display . "wayland-ewm-proof") (name . "native-second") (width . 50) (height . 15))))
(select-frame-set-input-focus native-proof-second)
(redisplay t)
(native-proof-wait (lambda () (= (native-proof-mapped-count) 2)))
(setq native-proof-counts (append native-proof-counts (list (native-proof-mapped-count))))
(delete-frame native-proof-first t)
(native-proof-wait (lambda () (= (native-proof-mapped-count) 1)))
(setq native-proof-counts (append native-proof-counts (list (native-proof-mapped-count))))
(delete-frame native-proof-second t)
(native-proof-wait (lambda () (= (native-proof-mapped-count) 0)))
(setq native-proof-counts (append native-proof-counts (list (native-proof-mapped-count))))
(garbage-collect)
(native-proof-retained-state)
(unless (and (= native-proof-pid (emacs-pid)) (eq native-proof-sentinel native-proof-alias)
             (equal (with-current-buffer native-proof-buffer (buffer-string)) "before native attachment")
             (equal (ewm-hello) "Hello from EWM compositor!") (daemonp))
  (error "Evaluator/module state lost after last native frame close"))
(setq native-proof-third (make-frame '((window-system . neo) (display . "wayland-ewm-proof") (name . "native-recreated") (width . 60) (height . 18))))
(select-frame-set-input-focus native-proof-third)
(set-window-buffer (frame-selected-window native-proof-third) native-proof-buffer)
(redisplay t)
(native-proof-wait (lambda () (= (native-proof-mapped-count) 1)))
(setq native-proof-counts (append native-proof-counts (list (native-proof-mapped-count))))
(with-temp-file (getenv "PROOF_OUTPUT")
  (prin1 `((strict_core_native_journey . t) (full_434_closure . nil) (future_native_display_predeclared . nil)
           (native_mapped_counts . ,native-proof-counts)
           (pid_before . ,native-proof-pid) (pid_after . ,(emacs-pid))
           (lisp_identity . ,(eq native-proof-sentinel native-proof-alias))
           (preserved_buffer . ,(with-current-buffer native-proof-buffer (buffer-string)))
           (module_hello . ,(ewm-hello)) (native_token . ,native-proof-token)
           (first_dead . ,(not (frame-live-p native-proof-first)))
           (second_dead . ,(not (frame-live-p native-proof-second)))
           (recreated_live . ,(frame-live-p native-proof-third))
           (display_list . ,(x-display-list))
           (native_state_before . ,native-proof-native-before)
           (native_state . ,(native-proof-retained-state))) (current-buffer)))
