+    /// Acceptance-only adapter: expose the native test backend to real clients.
+    pub fn run_acceptance_headless(mut self) -> Result<(), Box<dyn std::error::Error>> {
+        use smithay::wayland::socket::ListeningSocketSource;
+        let socket = ListeningSocketSource::with_name("wayland-ewm-proof")?;
+        self.event_loop.handle().insert_source(socket, |client, _, state| {
+            if let Err(err) = ClientState::insert(&mut state.ewm.display_handle, client) {
+                tracing::warn!("acceptance client insert: {err}");
+            }
+        })?;
+        let signal = self.event_loop.get_signal();
+        self.state.ewm.set_stop_signal(signal.clone());
+        let _ = crate::module::LOOP_SIGNAL.set(signal);
+        self.state.ewm.set_emacs_pid(std::process::id());
+        self.add_output("EWM-PROOF-1", 1024, 768);
+        self.state.ewm.queue_event(crate::event::Event::Ready);
+        self.event_loop.run(Some(Duration::from_millis(10)), &mut self.state, |state| {
+            state.refresh_and_flush_clients();
+        })?;
+        Ok(())
+    }
