+/// Acceptance-only entry point using upstream Fixture + HeadlessBackend.
+/// Never opens DRM, libinput, libseat, a VT, or an external display.
+#[defun]
+fn proof_start_headless() -> Result<bool> {
+    let mut state = compositor_state().lock().unwrap();
+    if state.thread.as_ref().is_some_and(|t| !t.is_finished()) {
+        return Ok(false);
+    }
+    STOP_REQUESTED.store(false, Ordering::SeqCst);
+    state.thread = Some(thread::spawn(|| {
+        let result = std::panic::catch_unwind(|| {
+            crate::testing::Fixture::new()?.run_acceptance_headless()
+        });
+        match result {
+            Ok(Ok(())) => (),
+            Ok(Err(err)) => eprintln!("EWM acceptance headless: {err}"),
+            Err(_) => eprintln!("EWM acceptance headless panicked"),
+        }
+    }));
+    Ok(true)
+}
